# .gitignore para projeto Java
# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package files
*.jar
*.war
*.ear

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Maven
/target/
!.mvn/wrapper/maven-wrapper.jar

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Eclipse
.project
.classpath
.settings/
.metadata/
.recommenders/

# IntelliJ IDEA
.idea/
*.iml
*.iws
/out/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.netbeans/

# VS Code
.vscode/

# Mac
.DS_Store

# Windows
Thumbs.db

# Files generated by IDEs or tools
*.log
*.tmp
*.bak
*.swp

# Build results
dist/
coverage/

# Distribution archives
*.zip
*.tar.gz

# Temporary files
*.class

# Ignore local environment files
.env

# Gradle wrapper and wrapper properties (keep wrapper jar if tracked)
gradle/wrapper/gradle-wrapper.properties

# IntelliJ misc
out/

# Ignore generated jars by build system
*.nar
*.exe
*.dll

# JRE dependencies
lib/

# If using any CI or tooling that produces reports
report/

# Uncomment if using Eclipse and you want to ignore the following:
# .settings/
# .externalToolBuilders
